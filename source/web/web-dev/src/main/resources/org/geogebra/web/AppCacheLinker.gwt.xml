<?xml version="1.0" encoding="UTF-8"?>
<module>  
  <!-- Upstream also added a linker that wrote a service worker caching the apps
       from www.geogebra.org; Locus does not ship it. The module keeps its name
       because other modules inherit it for the iframe linker below. -->
  <define-linker name="standardxsi" class="org.geogebra.web.linker.StandardIframeLinker" />
  <add-linker name="standardxsi" />
  <define-configuration-property is-multi-valued="true" name="es6export"/>
</module>
